{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "coverageAnalysis": "all",
  "ignoreStatic": true,
  "mutate": [
    "src/lib/agentPlanner.ts"
  ],
  "reporters": ["clear-text"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
